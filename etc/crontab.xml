<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="default">
        <job name="zero_redirects_import" instance="Zero\Redirects\Cron\Import" method="execute">
            <schedule>*/5 * * * *</schedule>
        </job>
        <job name="zero_redirects_forget" instance="Zero\Redirects\Cron\Forget" method="execute">
            <schedule>17 3 * * *</schedule>
        </job>
    </group>
</config>
