<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="zero_redirects" translate="label" type="text" sortOrder="34" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>404 Log and Redirects</label>
            <tab>zero</tab>
            <resource>Zero_Redirects::config</resource>
            <group id="log" translate="label comment" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>404 Log</label>
                <comment>Marketing > SEO &amp; Search > 404 Log lists the storefront addresses that answered "page not found", most asked for first, with a 301 redirect for each in one click (a Magento URL rewrite).</comment>
                <field id="enabled" translate="label comment" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Log 404s</label>
                    <comment>Off by default. Also switched on and off on the 404 Log page.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="ignore" translate="label comment" type="textarea" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Don't Log Addresses Containing</label>
                    <comment>One text per line, e.g. what vulnerability scanners try (wp-admin, .env). Static files and media are never logged.</comment>
                </field>
                <field id="keep_days" translate="label comment" type="text" sortOrder="30" showInDefault="1" canRestore="1">
                    <label>Forget Open 404s After (Days)</label>
                    <comment>An address nobody asked for since then leaves the log. Redirected and ignored ones stay.</comment>
                    <validate>validate-digits validate-greater-than-zero</validate>
                </field>
            </group>
        </section>
    </system>
</config>
